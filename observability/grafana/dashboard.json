{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "req/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:http_requests:rate1m{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform",
          "refId": "A"
        },
        {
          "expr": "portfolio:http_requests:rate1m{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub",
          "refId": "B"
        }
      ],
      "id": 1,
      "description": "Rate of instrumented HTTP requests. Missing metrics remain unavailable."
    },
    {
      "title": "Error Rate (5xx/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "errors/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:http_5xx:rate1m{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform",
          "refId": "A"
        },
        {
          "expr": "portfolio:http_5xx:rate1m{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub",
          "refId": "B"
        }
      ],
      "id": 2,
      "description": "HTTP 5xx per second, zero only when a request counter is present. This does not include HTTP-200 GraphQL errors."
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "seconds",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:http_latency:p50_5m{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform p50",
          "refId": "A"
        },
        {
          "expr": "portfolio:http_latency:p95_5m{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform p95",
          "refId": "B"
        },
        {
          "expr": "portfolio:http_latency:p99_5m{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform p99",
          "refId": "C"
        },
        {
          "expr": "portfolio:http_latency:p50_5m{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub p50",
          "refId": "D"
        },
        {
          "expr": "portfolio:http_latency:p95_5m{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub p95",
          "refId": "E"
        },
        {
          "expr": "portfolio:http_latency:p99_5m{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub p99",
          "refId": "F"
        }
      ],
      "id": 3,
      "description": "Histogram estimates in seconds over five minutes; absent histograms are unavailable. Existing integrations_hub does not expose this HTTP histogram."
    },
    {
      "title": "Webhook delivery attempts (per second)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "attempts/s",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:webhook_attempts:rate1m",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "description": "Rate of completed attempts by status, including retries. This counter cannot measure queue depth or unique deliveries. The synthetic fixture has no webhook worker."
    },
    {
      "title": "Webhook attempt duration p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "seconds",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:webhook_latency:p95_5m",
          "legendFormat": "attempt p95",
          "refId": "A"
        }
      ],
      "id": 5,
      "description": "Histogram estimate of an observed attempt's duration in seconds. Missing worker metrics remain unavailable."
    },
    {
      "title": "Metrics scrape availability",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"procurement-platform\"}",
          "legendFormat": "procurement-platform",
          "refId": "A"
        },
        {
          "expr": "up{job=\"integrations-hub\"}",
          "legendFormat": "integrations-hub",
          "refId": "B"
        }
      ],
      "id": 6,
      "description": "Prometheus up=1 means the metrics endpoint was scraped successfully; it does not prove database, API or business health."
    },
    {
      "id": 7,
      "title": "Events accepted (per second)",
      "description": "Rate of accepted event receipts by event_type. Synthetic fixture receipts are in memory and provide no durability evidence.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "portfolio:events_published:rate1m",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "portfolio",
    "overview"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Portfolio Overview",
  "uid": "portfolio-overview",
  "version": 2,
  "description": "Local telemetry wiring: rates, histogram estimates and scrape availability. Missing measurements are unavailable."
}
